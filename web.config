<?xml version="1.0" encoding="UTF-8"?>
<!--
  PoliMusic | Configuracion de IIS para la aplicacion

  Este archivo resuelve el error 403.14 que aparece al abrir la carpeta del
  proyecto en el navegador.

  Motivo: IIS NO incluye "index.asp" en su lista de documentos predeterminados
  (solo trae Default.htm, Default.asp, index.htm, index.html, iisstart.htm y
  default.aspx). Por eso, al pedir la carpeta, IIS no encontraba ningun
  documento que servir y respondia "403.14 - Forbidden".

  Con este archivo, al entrar a la carpeta se carga index.asp automaticamente.
-->
<configuration>
  <system.webServer>

    <!-- Documento predeterminado: index.asp pasa a ser el primero de la lista -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.asp" />
        <add value="Default.asp" />
        <add value="index.html" />
        <add value="Default.htm" />
      </files>
    </defaultDocument>

    <!-- Nunca mostrar el listado de carpetas -->
    <directoryBrowse enabled="false" />

  </system.webServer>
</configuration>
